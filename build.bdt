[module]
name = bdt
type = executable
languages = c

[sources]
files = src/main.c, src/cache.c, src/config.c, src/diagnostics.c, src/executor.c, src/graph.c, src/hash.c, src/lang.c, src/log.c, src/plugin.c, src/project.c, src/scanner.c, src/shared_cache.c, src/status.c, src/toolchain.c, src/trace.c, src/util.c, src/view.c
headers = src/bdt.h

[outputs]
executable = build/bdt
